# Wikitics local development environment

# Backend
APP_NAME=Wikitics
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://frontend:5173

# Database
DATABASE_URL=postgresql+psycopg://wikitics:wikitics@postgres:5432/wikitics       

# Object storage / local storage
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/app/storage
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=wikitics
S3_ACCESS_KEY_ID=wikitics
S3_SECRET_ACCESS_KEY=wikitics-secret
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true
S3_FORCE_PATH_STYLE=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# LiveKit
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Sarvam
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_STT_STREAM_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_STT_LANGUAGE_CODE=unknown
SARVAM_STT_STREAM_SAMPLE_RATE=16000
SARVAM_STT_INPUT_AUDIO_CODEC=pcm_s16le
SARVAM_STT_HIGH_VAD_SENSITIVITY=true
SARVAM_STT_VAD_SIGNALS=true
SARVAM_STT_FLUSH_SIGNAL=true
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_LANGUAGE_CODE=en-IN
SARVAM_TTS_SPEAKER=shubh
SARVAM_TTS_OUTPUT_AUDIO_CODEC=mp3
SARVAM_TTS_PACE=1.2
SARVAM_TTS_TEMPERATURE=0.45
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_TTS_WEBSOCKET_ENABLED=true
SARVAM_TTS_WS_MIN_BUFFER_SIZE=50
SARVAM_TTS_WS_MAX_CHUNK_LENGTH=200
SARVAM_TTS_WS_OUTPUT_AUDIO_BITRATE=128k
SARVAM_TTS_WS_TIMEOUT_SECONDS=30
SARVAM_DOCUMENT_INTELLIGENCE_URL=https://api.sarvam.ai/doc-digitization/job/v1
SARVAM_DOCUMENT_INTELLIGENCE_LANGUAGE=en-IN
SARVAM_DOCUMENT_INTELLIGENCE_OUTPUT_FORMAT=md
SARVAM_DOCUMENT_INTELLIGENCE_POLL_SECONDS=2
SARVAM_DOCUMENT_INTELLIGENCE_TIMEOUT_SECONDS=120
SARVAM_DOCUMENT_INTELLIGENCE_MAX_PAGES=10

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_TITLE_MODEL=openai/gpt-4o-mini
OPENROUTER_SUMMARY_MODEL=openai/gpt-4o-mini
OPENROUTER_WIKI_MODEL=openai/gpt-4.1-mini

# Agent worker
BACKEND_API_URL=http://backend:8000
AGENT_POLL_SECONDS=2
